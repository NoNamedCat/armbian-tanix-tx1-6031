+			ap_key_id_set = 1;
+		}
+		else if (!strcmp(argv[0], "key"))
+		{
+			strcpy(info_tmp.key, argv[1]);
+			info_tmp.keyLength = strlen(argv[1]);
+			if (wifi_param_check(&info_tmp, CHECK_KEY, 1))
+			{
+				goto err;
+			}
+			memcpy(&ap_cfg_set.ap_parameter, &info_tmp, sizeof(info_tmp));
