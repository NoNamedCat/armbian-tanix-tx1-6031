+	index = get_index(pmsgQ->output,pmsgQ->ecount);
+	actual_size = len>pmsgQ->actsize[index]?pmsgQ->actsize[index]:len;
+
+	memcpy(pbuf, pmsgQ->stack+index*pmsgQ->esize, actual_size);
+
+	if (pmsgQ->curcount == pmsgQ->ecount){
+		need_wake = 1;
