+
+	if (req_wrap->req->n_ssids > hw->wiphy->max_scan_ssids)
+	{
+		return -EINVAL;
+	}
+
+	frame.skb = ieee80211_probereq_get(hw, vif, NULL, 0,
+		req_wrap->req->ie, req_wrap->req->ie_len,
+		req_wrap->flags & IEEE80211_SCAN_REQ_NEED_BSSID ? req_wrap->bssid:NULL);
