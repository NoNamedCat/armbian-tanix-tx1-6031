-	}
-#ifdef ATBM_SURPORT_TDLS
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 1, 0))
-	/* The TDLS bit cannot be toggled after the STA was added */
-	if ((params->sta_flags_mask & BIT(NL80211_STA_FLAG_TDLS_PEER)) &&
