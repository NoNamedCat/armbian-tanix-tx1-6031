-
-	memset((u8 *)ble_hci_cmd_h2l_share, 0, sizeof(struct HCI_CMD_SHARE_PARAM));
-	memset((u8 *)ble_hci_cmd_l2h_share, 0, sizeof(struct HCI_CMD_SHARE_PARAM));
