+	if((chipversion >= 0xA1) && (chipversion <= 0xA3))
+		chanMax = 165;//5G max channel num
+
+	if((channel <= chanMin) || (channel > chanMax)){
+		atbm_printk_err("invalid channel!channel(%d)\n",channel);
+		return -EINVAL;
