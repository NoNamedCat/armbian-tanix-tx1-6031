-		printf("ble_hci_cmd_share cnt err\n");
-		assert(0);		
-	}
-
-	while((int)(ble_hci_acl_h2l_share->host_cnt - ble_hci_acl_h2l_share->ll_cnt) == HCI_ACL_SHARE_NUM){
