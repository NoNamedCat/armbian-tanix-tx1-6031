+u32 MyRand(void)
+{
+	u32 random_num = 0;
+	u32 randseed = 0;	
+
+#if (LINUX_VERSION_CODE > KERNEL_VERSION(5, 0, 0))
+	randseed = ktime_get_seconds();
+#else
+	struct timex txc;
+	do_gettimeofday(&(txc.time));
+	//randseed = jiffies;
+	randseed = txc.time.tv_sec;
+#endif
+	random_num = randseed * 1103515245 + 12345;
+	return ((random_num/65536)%32768);
+}
