+		}
+#endif
+		if(br0_priv ==NULL)
+			return 0;
+	     /*
+			printk("tx ehdr->h_source %x:%x:%x:%x:%x:%x h_proto %x (%x %x)\n",ehdr->h_source[0],
+														ehdr->h_source[1],
+														ehdr->h_source[2],
