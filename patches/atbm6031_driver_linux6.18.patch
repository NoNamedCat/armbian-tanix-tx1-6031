+static int atbm_ioctl_set_txpwr_by_file(struct net_device *dev, struct iw_request_info *info, union iwreq_data *wrqu, char *extra)
+{
+
+	//union iwreq_data *wdata = (union iwreq_data *)wrqu;
+	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
+	struct ieee80211_local *local = sdata->local;
+	struct atbm_common *hw_priv=local->hw.priv;
+	int ret = -1;
+	int if_id = -1;
+	char readbuf[1024] = "";
+	int deltagain[14]={0};
+	int bgain[13]={0};
+	int gngain[13]={0};
+	
+	//use delta_gain and dcxo value in config file,when file is exist
+	if(access_file(STR_FILE,readbuf,sizeof(readbuf),1) > 0)
+	{
+		atbm_printk_init("param:\n%s\n",readbuf);		
+		if(hw_priv->chip_version == Mercurius){
+			atbm_get_delta_gain_V2(readbuf,deltagain,bgain,gngain);
+		
+			if(deltagain[13]==0)
+				deltagain[13] = hw_priv->efuse.dcxo_trim;
+			//2.4G deltagain and dcxo
+			memset(readbuf, 0, sizeof(readbuf));
+			sprintf(readbuf, "set_txpwr_and_dcxo,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d ",deltagain[0], deltagain[1], deltagain[2], deltagain[13],
+				bgain[0], bgain[1], bgain[2],gngain[0], gngain[1], gngain[2]);
+			atbm_printk_init("2.4G cmd: %s\n", readbuf);
+			ret = wsm_write_mib(hw_priv, WSM_MIB_ID_FW_CMD, readbuf, strlen(readbuf), if_id);
+			//5G deltagain
+			memset(readbuf, 0, sizeof(readbuf));
+			sprintf(readbuf, "set_txpwr_5g,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d ",
+			deltagain[3],deltagain[4],deltagain[5],deltagain[6],deltagain[7],deltagain[8],deltagain[9],deltagain[10],deltagain[11],deltagain[12],
+			bgain[3],bgain[4],bgain[5],bgain[6],bgain[7],bgain[8],bgain[9],bgain[10],bgain[11],bgain[12],
+			gngain[3],gngain[4],gngain[5],gngain[6],gngain[7],gngain[8],gngain[9],gngain[10],gngain[11],gngain[12]);
+			atbm_printk_init("5G cmd: %s\n", readbuf);
+		ret = wsm_write_mib(hw_priv, WSM_MIB_ID_FW_CMD, readbuf, strlen(readbuf), if_id);
+		}
+		else{
+			atbm_get_delta_gain(readbuf,deltagain,bgain,gngain);
+			if(deltagain[3]==0)
+				deltagain[3] = hw_priv->efuse.dcxo_trim;
+			memset(readbuf, 0, sizeof(readbuf));
+			sprintf(readbuf, "set_txpwr_and_dcxo,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d ",deltagain[0], deltagain[1], deltagain[2], deltagain[3],
+				bgain[0], bgain[1], bgain[2],gngain[0], gngain[1], gngain[2]);
+			atbm_printk_init("cmd: %s\n", readbuf);
+			ret = wsm_write_mib(hw_priv, WSM_MIB_ID_FW_CMD, readbuf, strlen(readbuf), if_id);
+		}
+		
+		if(ret < 0){
+			atbm_printk_err("write mib failed(%d). \n", ret);
+		}
+	}
+
+	return ret;
+}
