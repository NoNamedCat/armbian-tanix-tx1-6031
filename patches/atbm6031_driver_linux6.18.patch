-static u8_t last_seg(u8_t len)
-{
-    if (len <= START_PAYLOAD_MAX) {
-        return 0;
-    }
-
-    len -= START_PAYLOAD_MAX;
-
-    return 1 + (len / CONT_PAYLOAD_MAX);
-}
