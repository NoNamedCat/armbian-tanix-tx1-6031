+void driver_go_sleep(void)
+{
+	if (is_insmod_driver)
+	{
+		char is_empty = 0;
+
+		sem_wait(&sem);
+		ioctl(fp, ATBM_PRE_RMMOD, 0);
+		while (1)
+		{
+			ioctl(fp, ATBM_TX_EMPTY, &is_empty);
+			if (is_empty)
+			{
+				break;
+			}
+			usleep(100*1000);
+		}
+		ioctl(fp, ATBM_FW_SLEEP, 0);
+		enable_driver(0);
+		sem_post(&sem);
+	}
+}
