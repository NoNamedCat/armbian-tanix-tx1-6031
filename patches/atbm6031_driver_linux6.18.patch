+int atbm_sdio_register_deinit()
+{
+	const struct atbm_platform_data *pdata;
+
+	pdata = atbm_get_platform_data();
+
+	atbm_sdio_deregister(&atmbwifi_driver);
+	atbm_sdio_off(pdata);
+
+	atbm_ioctl_free();
+
+	if (pdata->power_ctrl) {
+		pdata->power_ctrl(pdata, false);
+	}
+
+	if (pdata->clk_ctrl) {
+		pdata->clk_ctrl(pdata, false);
+	}
+	return 0;
+}
