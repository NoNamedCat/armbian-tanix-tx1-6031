+				printf("Line:%d no new key_mgmt values configured.\n", __LINE__);
+				goto err;
+			}
+
+			info_tmp.keyMgmt = key_type;
+			if (wifi_param_check(&info_tmp, CHECK_KEY_MGMT, 1))
+			{
+				goto err;
+			}
+			memcpy(&ap_cfg_set.ap_parameter, &info_tmp, sizeof(info_tmp));
