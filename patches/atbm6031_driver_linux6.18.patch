-static void link_close(struct prov_rx *rx, struct os_mbuf *buf)
-{
-    u8_t reason;
-    int i = prov_ctx.pb_index;
-
-    BT_DBG("len %u", buf->om_len);
-
-    reason = net_buf_simple_pull_u8(buf);
-
-    reset_link(i, reason);
