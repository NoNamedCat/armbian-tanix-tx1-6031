-unsigned char char2Hex(const char chart)
-{
-	unsigned char ret = 0;
-	if((chart>='0')&&(chart<='9')){
-		ret = chart-'0';		
-	}else if((chart>='a')&&(chart<='f')){
-		ret = chart - 'a'+0x0a;		
-	}else if((chart>='A')&&(chart<='F')){
-		ret = chart - 'A'+0x0a;
-	}
-	return ret;
-}
