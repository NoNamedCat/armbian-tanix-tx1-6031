-static int atbm_wait_dcxo_success(struct atbm_common*hw_priv,u8 successBit,u8 failBit)
-{
-	int ret ;	
-	u8 Dcxo_val_suc_fail;
-	while(1){
-		ret=atbm_reg_write_8(hw_priv,0x18,0x00+successBit/8);
