+void *get_power_status_func(void *arg)
+{
+	int fp = (int)arg;
+	int ret = 0;
+	char data = 0;
+
+	while (1)
+	{
+		ret = read(fp, &data, 1);
+		if (ret < 0)
+		{
+			if (!thread_run)
+			{
+				break;
+			}
+			continue;
+		}
+
+		if (data)
+		{
+			sem_wait(&sem);
+			enable_driver(data);
+			sem_post(&sem);
+			if (driver_switch)
+			{
+				raise(SIGIO);
+				driver_switch = 0;
+			}
+		}
+	}
+}
