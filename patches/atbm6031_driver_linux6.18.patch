+int atbm_rx_bh_flush(struct atbm_common *hw_priv)
+{
+	struct sk_buff *skb ;
+
+	while ((skb = atbm_skb_dequeue(&hw_priv->rx_frame_queue)) != NULL) {
+		//printk("test=====>atbm_kfree skb %p \n",skb);
+		atbm_dev_kfree_skb(skb);
+	}
+	return 0;
+}
