-//get chip crystal type
-u32 GetChipCrystalType(struct atbm_common *hw_priv)
-{	
-#ifndef SPI_BUS
-
-	u32 pin16 = 0;
-	u32 pin22 = 0;
-	u32 pin23 = 0;
-
-	u32 pin_reg;
-	u32 pin_reg17400000;
-	u32 chipID = 0;
-
-	atbm_direct_read_reg_32(hw_priv, 0xACC017C, &chipID);
-	chipID &= 0xff;
-
-	if(chipID == 0x49){
-		//--------AresB
-		atbm_direct_read_reg_32(hw_priv, 0x17400000, &pin_reg17400000);
-		atbm_direct_write_reg_32(hw_priv, 0x17400000, pin_reg17400000 | BIT(8));
-		atbm_direct_read_reg_32(hw_priv, 0x17400000, &pin_reg17400000);
-		if (pin_reg17400000 & BIT(17))
-		{
-			etf_config.chip_crystal_type = 1;
-		}
-		atbm_direct_read_reg_32(hw_priv, 0x16101010, &pin_reg);
-		if (pin_reg & BIT(5))
-		{
-			etf_config.chip_crystal_type |= BIT(1);
-		}
-		if (pin_reg & BIT(27))
-		{
-			etf_config.chip_crystal_type |= BIT(2);
-		}
-		atbm_direct_write_reg_32(hw_priv, 0x17400000, pin_reg17400000);
-	}
-	else if(chipID == 0x4A){
-		//--------Asmlite
-		//clk_sel:
-		HW_WRITE_REG_BIT(0x17400024, 3, 0, 3);
-		HW_WRITE_REG_BIT(0x16800028, 16, 16, 0);
-		HW_WRITE_REG_BIT(0x16800070, 16, 16, 0);
-		pin16 = HW_READ_REG_BIT(0x16800020, 16, 16);
-
-		//gpio22
-		HW_WRITE_REG_BIT(0x17400000,8,8,1);//gpio22
-		HW_WRITE_REG_BIT(0x17400030, 3, 0, 3);
-		HW_WRITE_REG_BIT(0x16800028, 22, 22, 0);
-		HW_WRITE_REG_BIT(0x16800070, 22, 22, 0);
-		pin22 = HW_READ_REG_BIT(0x16800020, 22, 22);
-		
-		//gpio23
-		HW_WRITE_REG_BIT(0x17400030, 19, 16, 3);
-		HW_WRITE_REG_BIT(0x16800028, 23, 23, 0);
-		HW_WRITE_REG_BIT(0x16800070, 23, 23, 0);
-		pin23 = HW_READ_REG_BIT(0x16800020, 23, 23);
-		if (pin16)
-		{
-			etf_config.chip_crystal_type = 1;//gpio 16
-		}
-		if (pin22)
-		{
-			etf_config.chip_crystal_type |= BIT(1);//gpio22
-		}
-		if (pin23)
-		{
-			etf_config.chip_crystal_type |= BIT(2); //gpio23
-		}
-	}
-
-	atbm_printk_always("crystal:%d\n",etf_config.chip_crystal_type);
-	return etf_config.chip_crystal_type;
-#else
-	return 0;
-#endif
-}
