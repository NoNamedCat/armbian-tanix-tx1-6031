-	if (mask & BIT(NL80211_STA_FLAG_MFP)) {
-		if (set & BIT(NL80211_STA_FLAG_MFP))
-			set_sta_flag(sta, WLAN_STA_MFP);
-		else
-			clear_sta_flag(sta, WLAN_STA_MFP);
