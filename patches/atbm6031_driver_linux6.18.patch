-    for (int i = 0; i < ARRAY_SIZE(link[id].tx.buf); i++) {
-        struct os_mbuf *buf = link[id].tx.buf[i];
-
-        if (!buf) {
-            break;
-        }
-
-        if (i + 1 < ARRAY_SIZE(link[id].tx.buf) && link[id].tx.buf[i + 1]) {
-            bt_mesh_adv_send(buf, NULL, NULL);
-        } else {
-            bt_mesh_adv_send(buf, &buf_sent_cb, (void *)id);
-        }
-    }
