+		//const char *sdd_path = sdd;
+		struct wsm_configuration cfg = {
+			.dot11StationId = &hw_priv->mac_addr[0],
+			.dot11RtsThreshold = 1000,
+		};
+//#define CONFIG_SUPPORT_SDD
