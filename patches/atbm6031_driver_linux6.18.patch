+{
+	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
+	struct atbm_vif *priv = (struct atbm_vif *)sdata->vif.drv_priv;
+    struct atbm_common *hw_priv = priv->hw_priv;
