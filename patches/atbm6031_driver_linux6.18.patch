+				atbm_printk_exit("%s:hw_priv->bh_error\n",__func__);
+			#endif
+		}
+		else {
+			term = 1;
+		}
+#ifdef CONFIG_PM
+		atbm_pm_stay_awake(&hw_priv->pm_state, 3*HZ);
