+bool ieee80211_scan_policy_prepare(struct ieee80211_sub_if_data *sdata)
+{
+	struct ieee80211_local *local = sdata->local;
+	u8 index = 0;
+	struct ieee80211_scan_policy *policy;
+	struct ieee80211_scan_policy_requset request;
+	enum scan_policy_results results;
+	
+	INIT_LIST_HEAD(&local->scan_policy);
+	memset(&request,0,sizeof(struct ieee80211_scan_policy_requset));
+
+	request.action = SCAN_POLICY_ACTION_INIT;
+	request.sdata  = sdata;
+	for(index = 0; index < IEEE80211_SCAN_POLICY_MAX ; index++){
+		policy = &sdata->scan_policy[index];
+		request.policy = policy;
+		results = policy->func ? policy->func(&request) : SCAN_POLICY_RESULTS_SKIP;
+		
+		switch(results){
+		case SCAN_POLICY_RESULTS_OK:
+			list_add_tail(&policy->list,&local->scan_policy);
+			break;
+		case SCAN_POLICY_RESULTS_SKIP:
+			break;
+		case SCAN_POLICY_RESULTS_FINISHED:
+			list_add_tail(&policy->list,&local->scan_policy);
+			index = IEEE80211_SCAN_POLICY_MAX;
+			break;
+		}
+	}
+
+	return list_empty(&local->scan_policy) ? false : true;
+}
+void ieee80211_scan_policy_init(struct ieee80211_sub_if_data *sdata)
+{
+	u8 index = 0;
+	struct ieee80211_scan_policy *policy;
+	
+	for(index = 0; index < IEEE80211_SCAN_POLICY_MAX; index++){
+		
+		policy = &sdata->scan_policy[index];
+		memset(policy,0,sizeof(struct ieee80211_scan_policy));
+		
+		
+		switch(index){
+		case IEEE80211_SCAN_POLICY_USER_CHANNEL:
+			policy->func   = ieee80211_scan_policy_user;
+			break;
+		case IEEE80211_SCAN_POLICY_2_4G:
+			policy->band   = IEEE80211_BAND_2GHZ;
+			policy->func   = ieee80211_scan_policy_2G;
+			break;
+#if defined (CONFIG_ATBM_APOLLO_5GHZ_SUPPORT)
+		case IEEE80211_SCAN_POLICY_5G_ON_IR:
+			policy->band   = IEEE80211_BAND_5GHZ;
+			policy->func   = ieee80211_scan_policy_5G_no_ir;
+			break;
+#endif
+#if  defined (CONFIG_ATBM_5G_PRETEND_2G) || defined (CONFIG_ATBM_APOLLO_5GHZ_SUPPORT)
+		case IEEE80211_SCAN_POLICY_5G_IR:
+			policy->band   = IEEE80211_BAND_5GHZ;
+			policy->func   = ieee80211_scan_policy_5G_ir;
+			break;
+#endif
+		default:
+			break;
+			
+		}
+	}
+}
+void ieee80211_scan_policy_rx(struct ieee80211_sub_if_data *sdata, struct sk_buff *skb)
+{
+	struct ieee80211_local *local = sdata->local;
+	struct ieee80211_scan_policy *policy = local->policy;
+	struct atbm_ieee80211_mgmt *mgmt;
+	struct ieee80211_rx_status *rx_status = IEEE80211_SKB_RXCB(skb);
+	u8 *elements;
+	struct ieee80211_channel *channel;
+	size_t baselen;
+	int freq;
+	__le16 fc;
+	bool presp, beacon = false;
+	struct ieee802_atbm_11_elems elems;
+	struct ieee80211_scan_policy_requset request;
+	
+	if(policy == NULL || policy->func == NULL){
+		return;
+	}
+	
+	if (skb->len < 2)
+		return;
+
+	mgmt = (struct atbm_ieee80211_mgmt *) skb->data;
+	fc = mgmt->frame_control;
+
+	if (ieee80211_is_ctl(fc))
+		return;
+
+	if (skb->len < 24)
+		return;
+	
+	if(sdata->local->scan_sdata != sdata){
+		return;
+	}
+	presp = ieee80211_is_probe_resp(fc);
+	if (presp) {
+		/* ignore ProbeResp to foreign address */
+		if (memcmp(mgmt->da, sdata->vif.addr, ETH_ALEN))
+			return ;
+
+		presp = true;
+		elements = mgmt->u.probe_resp.variable;
+		baselen = offsetof(struct atbm_ieee80211_mgmt, u.probe_resp.variable);
+	} else {
+		beacon = ieee80211_is_beacon(fc);
+		baselen = offsetof(struct atbm_ieee80211_mgmt, u.beacon.variable);
+		elements = mgmt->u.beacon.variable;
+	}
+	if (!presp && !beacon)
+		return ;
+
+	if (baselen > skb->len)
+		return ;
+
+	ieee802_11_parse_elems(elements, skb->len - baselen, &elems);
+
+	if (elems.ds_params && elems.ds_params_len == 1)
+		freq = ieee80211_channel_to_frequency(elems.ds_params[0],
+						      rx_status->band);
+	else
+		freq = rx_status->freq;
+
+	channel = ieee80211_get_channel(sdata->local->hw.wiphy, freq);
+
+	if(channel == NULL){
+		return;
+	}
+
+	memset(&request,0,sizeof(struct ieee80211_scan_policy_requset));
+
+	request.action = SCAN_POLICY_ACTION_PREPARE_RX;
+	request.policy = policy;
+	request.sdata  = local->scan_sdata;
+	request.priv   = channel;
+	BUG_ON(policy->func == NULL);
+	policy->func(&request);
+}
+//EXPORT_SYMBOL(ieee80211_sched_scan_stopped);
