+
+        case WLAN_CIPHER_SUITE_TKIP:
+                sta_printk( "[STA] WPA\n");
+                encrypthdr = WPA_ENCRYPT_HDR_SIZE;
+                encrypttailsize = WPA_ENCRYPT_TAIL_SIZE;
+                encrypt = 1;
+                break;
+
+        case WLAN_CIPHER_SUITE_CCMP:
