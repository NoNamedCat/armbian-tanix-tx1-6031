+static void
+_br0_free(struct NETWIFI_S_BRIDGE *br0_priv, struct NET_BR0_INFO_ENTRY *br_info)
+{
+   // BR0_LOCK_ASSERT(br0_priv);
+
+    br0_de_queue(&br_info->br0_list);
+    br0_de_queue(&br_info->br0_hash);
+//        LIST_REMOVE(NET_BR0_INFO_ENTRY, br0_hash);
+    atbm_kfree(br_info);
+}
