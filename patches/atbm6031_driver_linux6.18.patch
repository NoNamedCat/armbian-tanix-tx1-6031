-int atbm_internal_addr_read_bit(struct atbm_common *hw_priv,u32 addr,u8 endBit,
-	u8 startBit,u32 *data )
-{                                                              
-	u32	reg_val=0;                                        
-	u32 regmask=0;
-	int ret = 0;
-	
-	ret=atbm_direct_read_reg_32(hw_priv,addr,&reg_val); 
-	if(ret<0){
-		goto rw_end;
-	}                             
-	regmask = ~((1<<startBit) -1);                               
-	regmask &= ((1<<endBit) -1)|(1<<endBit);                     
-	reg_val &= regmask;                                      
-	reg_val >>= startBit; 
-	
-	*data = reg_val;
-rw_end:
-	return ret;
-}   
