+void wsm_alloc_tx_buffer(struct atbm_common *hw_priv)
+{
+	++hw_priv->hw_bufs_used;
+}
+
+int wsm_release_tx_buffer(struct atbm_common *hw_priv, int count)
+{
+	int ret = 0;
+
+	hw_priv->hw_bufs_used -= count;
+	ret = 1;
+	return ret;
+}
