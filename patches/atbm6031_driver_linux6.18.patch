+	
+//	del_timer_sync(&sdata->u.mgd.scan_delay_timer);
+//	mod_timer(&sdata->u.mgd.scan_delay_timer,jiffies +  msecs_to_jiffies(10000));
+	
+	return ieee80211_mgd_assoc(IEEE80211_DEV_TO_SUB_IF(dev), req);
+}
