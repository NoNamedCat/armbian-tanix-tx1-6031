-		ieee80211_queue_delayed_work(&local->hw, &found->work, 0);
-
-		mutex_unlock(&local->mtx);
-
-		/* work will clean up etc */
-		atbm_flush_delayed_work(&found->work);
-	}
-
-	return 0;
-}
