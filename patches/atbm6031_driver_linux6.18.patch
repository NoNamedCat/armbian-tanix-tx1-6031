+static int provisioner_check_net_key_full(void)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(bt_mesh.p_sub); i++) {
+        if (!bt_mesh.p_sub[i].subnet_active) {
+            return i;
+        }
+    }
+
+    return -ENOMEM;
+}
