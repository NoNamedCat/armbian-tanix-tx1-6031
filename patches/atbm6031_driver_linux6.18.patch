-    while(!is_queue_empty()) {
-        skb = rx_skb_queue[rx_skb_queue_front];
-        rx_skb_queue[rx_skb_queue_front] = NULL;
-        rx_skb_queue_front++;
-        rx_skb_queue_front %= QUEUE_SIZE;
-        if (skb) {
-            kfree_skb(skb);
-        }
-    }
-    spin_unlock(&queue_lock);
