+	*/
+	ATBM_WEXT_PROCESS_PARAMS(pos,len,queue,atbm_accsii_to_int,false,exit,ret);
+	if((queue < 0) || (queue >= 4)){
+		ret = -EINVAL;
+		goto exit;
