+static int
+atbm_tx_h_rate_policy(struct atbm_common *hw_priv,
+			struct atbm_txinfo *t,
+			struct wsm_tx *wsm)
+{
+
+	bool tx_policy_renew = false;
+	struct atbm_vif *priv =
+				ABwifi_get_vif_from_ieee80211(t->tx_info->control.vif);
+#ifdef CONFIG_ATBM_APOLLO_TESTMODE
