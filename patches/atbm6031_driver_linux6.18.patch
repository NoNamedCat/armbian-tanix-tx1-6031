+static inline bool ieee8011_channel_valid(struct ieee80211_hw *hw,int channel)
+{
+	int freq;
+	struct ieee80211_channel *ch;
+	if(channel<=0)
+		return false;
+
+	if(channel<14){
+		freq = 2412+(channel-1)*5;
+	}else if(channel == 14){
+		freq = 2484;
+	}else{
+		freq = 5000 + 5 * channel;
+	}
+
+	ch = ieee80211_get_channel(hw->wiphy,freq);
+
+	return ch == NULL ? false:true;
