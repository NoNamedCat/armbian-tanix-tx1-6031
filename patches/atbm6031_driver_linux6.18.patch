-                         MYNEWT_VAL(BLE_HCI_EVT_LO_BUF_COUNT),
-                         MYNEWT_VAL(BLE_HCI_EVT_BUF_SIZE),
-                         ble_hci_ram_evt_lo_buf,
-                         "ble_hci_ram_evt_lo_pool");
