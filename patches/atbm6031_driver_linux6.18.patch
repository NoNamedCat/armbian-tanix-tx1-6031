+		break;
+	}
+	case SCAN_POLICY_ACTION_PREPARE_CHANNEL:{
+		struct ieee80211_channel *channel = request->priv;
+
+		if(channel->band != policy->band){
+			results = SCAN_POLICY_RESULTS_SKIP;
+			break;
+		}
+		if(test_bit(channel_hw_value(channel),policy->channel_unmap)){
+			results = SCAN_POLICY_RESULTS_SKIP;
+			break;
+		}
+		results = SCAN_POLICY_RESULTS_OK;
+		break;
+	}
+	case SCAN_POLICY_ACTION_PREPARE_RX:
+		results = SCAN_POLICY_RESULTS_OK;
