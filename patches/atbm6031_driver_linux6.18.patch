-static int tokenize_cmd(char *cmd, char *argv[], int is_at_cmd)
-{
-	char *pos;
-	int argc = 0;
-
-	pos = cmd;
-	for (;;) {
-		while (*pos == ' ')
-			pos++;
-		if (*pos == '\0')
-			break;
-		if (*pos == '"') {
-			argv[argc] = pos + 1;
-			char *pos2 = strrchr(pos, '"');
-			if (pos2) {
-				*pos2 = '\0';
-				pos = pos2 + 1;
-			}
-		}
-		else {
-			argv[argc] = pos;
-		}
-		argc++;
-		if (argc == MAX_ARGS)
-			break;
-		if (is_at_cmd)
-		{
-			if (argc > 1)
-				break;
-		}
-		while (*pos != '\0' && *pos != ' ')
-			pos++;
-		if (*pos == ' ')
-			*pos++ = '\0';
-	}
-
-	return argc;
-}
