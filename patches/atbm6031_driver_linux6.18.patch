-		printf("%02X ", data[i]);
-		if(0 == ((i+1)%16)){
-			printf("\n");
-			printf("data:");
-		}
-	}
-	printf("\n");
-#endif
-
-	ble_hci_acl_h2l_share->host_cnt ++;
-	wifi_notify_ble_int();
-	OS_EXIT_CRITICAL(sr);
-
-    return 0;
-}
