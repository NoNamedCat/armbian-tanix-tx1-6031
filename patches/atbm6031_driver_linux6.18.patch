+	}
+	
+	if(atbm_accsii_to_int(pos,len,&channel) == false){		
+		ret = -EINVAL;
+		goto exit;
+	}
+	ret = ieee80211_set_sta_channel(sdata,channel);
+	
+exit:
+	if(ptr)
+		atbm_kfree(ptr);
+	return ret;
+}
