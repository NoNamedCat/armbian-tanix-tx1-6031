+int MacStringToHex(char *mac, u8  *umac)
+{
+	int i = 0, j = 0;
+	unsigned char d = 0;
+	char ch = 0,buffer[12] = {0};
+
+	if(mac)
+		memcpy(buffer, mac, strlen(mac));
+
+    for (i=0;i<12;i++)
+    {
+        ch = buffer[i];
+
+        if (ch >= '0' && ch <= '9')
+        {
+            d = (d<<4) | (ch - '0');
+        }
+        else if (ch >= 'a' && ch <= 'f')
+        {
+            d = (d<<4) | (ch - 'a' + 10);
+        }
+        else if (ch >= 'A' && ch <= 'F')
+        {
+            d = (d<<4) | (ch - 'A' + 10);
+        }
+		if((i%2 == 1)){
+			umac[j++] = d;
+			d = 0;
+		}
+    }
+
+    return 0;
+}
