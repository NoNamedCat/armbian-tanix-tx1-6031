+	int i;
+	u32 dur_val = 0;
+	if((len > 12) && (!memcmp(extra,"set_adaptive",12))){
+		if(extra[13] == '1'){
+			sdata->local->adaptive_started = true;
+			sdata->local->adaptive_started_time = jiffies;
+			atbm_printk_err("adaptive_started!\n");
+			atbm_wifi_adative_set(1);
+		}else if(extra[13] == '0')	{
+			sdata->local->adaptive_started = false;
+			atbm_printk_err("adaptive_stoped!\n");
+			atbm_wifi_adative_set(0);
+		}	
+	}else if((len > 3) && (!memcmp(extra,"cfo",3))){
+		if(extra[4] == '0'){
+			atbm_wifi_cfo_set(0);
+		}else{
+			//extra[4] = '1';
+			atbm_wifi_cfo_set(extra[4]-'0');
+		}
+	}
+	else if((len > 7)&&(!memcmp(extra, "set_dur", 7)))
+	{
+		for(i = 8;i < len - 1;i++)
+		{
+			dur_val = dur_val * 10 + (extra[i] - 0x30);
+		}
+		wsm_write_mib(sdata->local->hw.priv, WSM_MIB_ID_SET_RTS_DUR, &dur_val, sizeof(dur_val), 0);
+	}
+	return 0;
+}
