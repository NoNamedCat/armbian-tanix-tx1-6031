+                encrypthdr = WPA2_ENCRYPT_HDR_SIZE;
+                encrypttailsize = WPA2_ENCRYPT_TAIL_SIZE;
+                encrypt = 1;
+                break;
+
+		case WLAN_CIPHER_SUITE_AES_CMAC:
+                sta_printk( "[STA] WPA2\n");
+                encrypthdr = WPA2_ENCRYPT_HDR_SIZE;
+                encrypttailsize = WPA2_ENCRYPT_TAIL_SIZE;
